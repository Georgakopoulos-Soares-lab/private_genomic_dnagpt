# --- Model weights & checkpoints (NEVER commit — license/terms + size) ---
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pb
*.bin
*.npz
weights/
checkpoints/
models/
*.tfrecord
*.sif
.hf_cache/

# --- Homomorphic-encryption key material (SECURITY-CRITICAL — never commit) ---
*.key
*.pem
*.p12
*.pfx
*.evalkey
*.galoiskey
*.relinkey
keys/
*.seckey
*.pubkey

# --- Secrets / credentials ---
.env
.env.*
credentials*
secrets*
kubeconfig*
*token*
# DNAGPT source file (not a secret) — exempt from the *token* rule above:
!**/tokenizer.py
*.secret

# --- Encrypted ciphertext blobs & FHE artifacts (large, regenerable) ---
*.ct
*.ctxt
ciphertexts/
compiled_circuits/
*.mlir

# --- Data (genomic inputs may be sensitive) ---
data/
*.fasta
*.fa
*.vcf
*.bed
*.bigwig
*.bw

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv*/
venv/
env/
# `env/` above targets Python virtualenvs, but it also swallowed kimon/env/,
# which holds the tracked TACC setup scripts. Un-ignore that one directory; its
# large artifacts (.sif/.tar, FIDESlib checkout + install) are excluded in
# kimon/.gitignore.
!kimon/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Benchmark outputs (keep summaries in docs, not raw logs) ---
results/raw/
*.prof

# --- Miscellaneous ---
checkpoints/

# === Paper build artifacts ===
paper-docs/.venv-paper/
paper-docs/manuscript/source/*.aux
paper-docs/manuscript/source/*.bbl
paper-docs/manuscript/source/*.blg
paper-docs/manuscript/source/*.fdb_latexmk
paper-docs/manuscript/source/*.fls
paper-docs/manuscript/source/*.lof
paper-docs/manuscript/source/*.log
paper-docs/manuscript/source/*.lot
paper-docs/manuscript/source/*.out
paper-docs/manuscript/source/*.run.xml
paper-docs/manuscript/source/*.synctex.gz
paper-docs/manuscript/source/*.toc
paper-docs/manuscript/source/*.xdv
# The compiled manuscript is a build artifact: run scripts/build.sh to make it.
paper-docs/manuscript/source/main.pdf
paper-docs/scripts/__pycache__/
# Generated figures ARE tracked: paper-docs/manuscript/figures/*.pdf

# Prior published papers: reference only, large, not ours to redistribute here
paper-docs/context/prior_papers/*.pdf

# kimon run/telemetry logs are tracked evidence, not scratch output
!kimon/logs/
!kimon/logs/**
