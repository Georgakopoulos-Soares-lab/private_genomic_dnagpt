# Run outputs and the built container image are large / machine-specific.
# Scripts + guides ARE tracked; logs and the .sif/tar are not.
logs/
env/*.sif
env/*.tar
env/*.tar.gz
# Native FIDESlib path: upstream checkout + local install prefix (regenerable
# via env/clone_fideslib.sh + env/build_fideslib_native.sh).
env/fideslib-src/
env/fideslib-install/
